# Copia este archivo a .env y ajusta los valores para tu entorno local.
# Todos los valores de abajo son ficticios y solo sirven para desarrollo local.

# Usuario de PostgreSQL.
POSTGRES_USER=taskflow

# Contraseña de PostgreSQL. En local basta con un valor ficticio.
POSTGRES_PASSWORD=taskflow_local_pw

# Nombre de la base de datos.
POSTGRES_DB=taskflow

# Puerto del host donde se publica PostgreSQL.
POSTGRES_PORT=5432

# URL de conexión que usa la app (SQLAlchemy async + asyncpg).
# Deriva de los POSTGRES_* de arriba. Valor ficticio para desarrollo local.
DATABASE_URL=postgresql+asyncpg://taskflow:taskflow_local_pw@localhost:5432/taskflow
